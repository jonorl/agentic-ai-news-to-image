# Cloudflare Pages applies these to every response, and rename-worker passes them through on
# jonathan-orlowski.dev/agentic-ai-news-to-image/. The stored story and "Run Workflow" both go to
# api.jonathan-orlowski.dev, and the images are on Cloudinary; a broken image is swapped for a data: SVG. Cloudflare Web
# Analytics injects its beacon from static.cloudflareinsights.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://res.cloudinary.com; font-src 'self'; connect-src 'self' https://api.jonathan-orlowski.dev https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Built files carry a content hash in their name, so a changed file always gets a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
