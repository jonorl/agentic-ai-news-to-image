{
  "expo": {
    "name": "Agentic News",
    "slug": "mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.jonathanorlowski.agenticnews"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.jonathanorlowski.agenticnews",
      "versionCode": 1
    },
    "plugins": [
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "platforms": [
      "android"
    ]
  }
}
